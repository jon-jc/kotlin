# Copy to server/.env and fill on the deployment host. Never put secret values in Android.
ROAM_ENV=production
PORT=8080
DATABASE_URL=jdbc:postgresql://replace-database-host:5432/postgres?sslmode=verify-full
DATABASE_USER=replace-database-user
DATABASE_PASSWORD=replace-database-password
SUPABASE_URL=https://replace-project.supabase.co
STRIPE_SECRET_KEY=replace-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-stripe-webhook-signing-secret
# Both this switch and an sk_live_ key are required to accept real money.
ROAM_LIVE_PAYMENTS=false
# Set only after configuring edge limits; avoids grouping every user under the proxy's IP.
ROAM_INGRESS_RATE_LIMITED=true

# Optional public live accommodation comparison. Never embed this private key in Android.
# All-accommodation search costs up to two fresh upstream searches; property details costs one.
SERPAPI_API_KEY=replace-serpapi-api-key
# Acknowledge paid public access only after edge limits AND the provider account spend budget exist.
ROAM_COMPARISON_PUBLIC_ACCESS=false
# Hard defense per process/UTC day; counters reset on restart and do not span replicas.
ROAM_COMPARISON_DAILY_REQUEST_LIMIT=200
